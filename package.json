        },
        {
          "command": "superMarkdown.zhCN.openWysiwygEditor",
          "when": "superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.en.openPreview",
          "when": "!superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.zhCN.openPreview",
          "when": "superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.en.openSplitEditMode",
          "when": "!superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.zhCN.openSplitEditMode",
          "when": "superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.en.switchDisplayLanguage",
          "when": "!superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.zhCN.switchDisplayLanguage",
          "when": "superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.en.switchBackgroundTheme",
          "when": "!superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.zhCN.switchBackgroundTheme",
          "when": "superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.en.refreshPreview",
          "when": "!superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.zhCN.refreshPreview",
          "when": "superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.en.organizeMarkdown",
          "when": "!superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.zhCN.organizeMarkdown",
          "when": "superMarkdown.runtimeLanguageZhCN"
        }
      ]
    },
    "configurationDefaults": {
      "[markdown]": {
        "editor.defaultFormatter": "SivanLiu.super-markdown",
        "editor.wordWrap": "on",
        "editor.unicodeHighlight.ambiguousCharacters": false
      },
      "workbench.editorAssociations": {
        "*.md": "superMarkdown.editor",
        "*.markdown": "superMarkdown.editor",
        "*.mdown": "superMarkdown.editor",
        "*.mkdn": "superMarkdown.editor"
      }
    },
    "configuration": {
      "title": "Super Markdown",
      "properties": {
        "superMarkdown.preview.theme": {
          "type": "string",
          "enum": [
            "system",
            "light",
            "dark",
            "sage",
            "paper",
            "ocean",
            "solarized",
            "rose",
            "lavender",
            "graphite",
            "forest",
            "terminal",
            "ink",
            "high-contrast"
          ],
          "default": "system",
          "description": "%superMarkdown.configuration.preview.theme.description%",
          "enumDescriptions": [
            "%superMarkdown.configuration.preview.theme.system%",
            "%superMarkdown.configuration.preview.theme.light%",
            "%superMarkdown.configuration.preview.theme.dark%",
            "%superMarkdown.configuration.preview.theme.sage%",
            "%superMarkdown.configuration.preview.theme.paper%",
            "%superMarkdown.configuration.preview.theme.ocean%",
            "%superMarkdown.configuration.preview.theme.solarized%",
            "%superMarkdown.configuration.preview.theme.rose%",
            "%superMarkdown.configuration.preview.theme.lavender%",
            "%superMarkdown.configuration.preview.theme.graphite%",
            "%superMarkdown.configuration.preview.theme.forest%",
            "%superMarkdown.configuration.preview.theme.terminal%",
            "%superMarkdown.configuration.preview.theme.ink%",
            "%superMarkdown.configuration.preview.theme.highContrast%"
          ]
        },
        "superMarkdown.preview.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 10,
          "maximum": 24,
          "description": "%superMarkdown.configuration.preview.fontSize.description%"
        },
        "superMarkdown.preview.maxWidth": {
          "type": "number",
          "default": 860,
          "minimum": 520,
          "maximum": 1400,
          "description": "%superMarkdown.configuration.preview.maxWidth.description%"
        },
        "superMarkdown.toc.levels": {
          "type": "string",
          "default": "1..6",
          "pattern": "^[1-6](\\.\\.[1-6])?$",
          "description": "%superMarkdown.configuration.toc.levels.description%"
        },
        "superMarkdown.organize.updateTocOnSave": {
          "type": "boolean",
          "default": false,
          "description": "%superMarkdown.configuration.organize.updateTocOnSave.description%"
        },
        "superMarkdown.organize.numberHeadings": {
          "type": "boolean",
          "default": false,
          "description": "%superMarkdown.configuration.organize.numberHeadings.description%"
        },
        "superMarkdown.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "%superMarkdown.configuration.format.enable.description%"
        },
        "superMarkdown.format.punctuationWidth": {
          "type": "string",
          "enum": [
            "auto",
            "half",
            "preserve"
          ],
          "default": "auto",
          "description": "%superMarkdown.configuration.format.punctuationWidth.description%"
        },
        "superMarkdown.format.punctuationSpacing": {
          "type": "string",
          "enum": [
            "half",
            "full",
            "all",
            "none"
          ],
          "default": "half",
          "description": "%superMarkdown.configuration.format.punctuationSpacing.description%"
        },
        "superMarkdown.format.table.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%superMarkdown.configuration.format.table.enabled.description%"
        },
        "superMarkdown.format.table.cjkCharWidth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 3,
          "description": "%superMarkdown.configuration.format.table.cjkCharWidth.description%"
        },
        "superMarkdown.format.list.markerStyle": {
          "type": "string",
          "enum": [
            "preserve",
            "cycle"
          ],
          "default": "cycle",
          "description": "%superMarkdown.configuration.format.list.markerStyle.description%"
        },
        "superMarkdown.format.list.markerCycle": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "*",
              "+",
              "-"
            ]
          },
          "default": [
            "*",
            "+",
            "-"
          ],
          "description": "%superMarkdown.configuration.format.list.markerCycle.description%"
        },
        "superMarkdown.format.list.padOrderedNumbers": {
          "type": "boolean",
          "default": true,
          "description": "%superMarkdown.configuration.format.list.padOrderedNumbers.description%"
        },
        "superMarkdown.format.code.enabled": {
          "type": "boolean",
