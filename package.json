  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run bundle && npm run copy-assets",
    "clean:tsc": "node -e \"require('fs').rmSync('out-tsc',{recursive:true,force:true})\"",
    "compile": "npm run clean:tsc && tsc -p ./",
    "bundle": "npm run bundle:extension && npm run bundle:webview",
    "bundle:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --sourcemap",
    "bundle:webview": "esbuild media/wysiwyg/editor-runtime.ts --bundle --format=iife --target=es2022 --minify --outfile=media/wysiwyg/editor.js --sourcemap",
    "copy-assets": "node scripts/copy-assets.mjs",
    "dev:host": "node scripts/open-dev-host.mjs",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && mocha --ui tdd \"out-tsc/test/**/*.test.js\"",
    "test:webview-toolbar": "npm run bundle:webview && playwright test -c playwright.webview.config.ts",
    "verify:vsix-contents": "node scripts/verify-vsix-contents.mjs",
    "package": "npm run package:vsix",
    "package:vsix": "node -e \"require('fs').mkdirSync('dist',{ recursive: true })\" && vsce package --out dist/super-markdown.vsix",
    "openvsx:create-namespace": "ovsx create-namespace SivanLiu",
    "openvsx:verify-token": "ovsx verify-pat SivanLiu",
    "openvsx:publish": "ovsx publish --skip-duplicate"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.19.130",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^8.57.1",
    "mocha": "11.3.0",
    "ovsx": "^0.10.11",
    "typescript": "^5.8.3"
  },
  "overrides": {
