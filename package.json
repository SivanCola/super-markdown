{
  "name": "super-markdown",
  "displayName": "Super Markdown",
  "description": "Structured Markdown preview, navigation, document health checks, and safe cleanup for VS Code.",
  "version": "0.1.3",
  "publisher": "SivanLiu",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#102033",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SivanCola/super-markdown.git"
  },
  "homepage": "https://github.com/SivanCola/super-markdown#readme",
  "bugs": {
    "url": "https://github.com/SivanCola/super-markdown/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Markdown editing, preview, toolbar interactions, and split scroll sync are available in Restricted Mode. File-writing actions such as image upload and export only run after an explicit user command."
    }
  },
  "categories": [
    "Formatters",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "preview",
    "toc",
    "outline",
    "formatter"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:superMarkdown.openEditor",
    "onCommand:superMarkdown.openNativeTextEditor",
    "onCommand:superMarkdown.openWysiwygEditor",
    "onCommand:superMarkdown.openPreview",
    "onCommand:superMarkdown.openSplitEditMode",
    "onCommand:superMarkdown.switchDisplayLanguage",
    "onCommand:superMarkdown.switchBackgroundTheme",
    "onCommand:superMarkdown.refreshPreview",
    "onCommand:superMarkdown.organizeMarkdown",
    "onCommand:superMarkdown.export.settings",
    "onCommand:superMarkdown.export.html",
    "onCommand:superMarkdown.export.pdf",
    "onCommand:superMarkdown.export.png",
    "onCommand:superMarkdown.export.jpeg",
    "onCommand:superMarkdown.export.all",
    "onCommand:superMarkdown.export.choose",
    "onCommand:superMarkdown.openSyntaxGuide",
    "onCommand:superMarkdown.copyTableAsJson",
    "onCommand:superMarkdown.copyJsonAsTable",
    "onCustomEditor:superMarkdown.editor",
    "onCommand:superMarkdown.en.openEditor",
    "onCommand:superMarkdown.zhCN.openEditor",
    "onCommand:superMarkdown.en.openNativeTextEditor",
    "onCommand:superMarkdown.zhCN.openNativeTextEditor",
    "onCommand:superMarkdown.en.openWysiwygEditor",
    "onCommand:superMarkdown.zhCN.openWysiwygEditor",
    "onCommand:superMarkdown.en.openPreview",
    "onCommand:superMarkdown.zhCN.openPreview",
    "onCommand:superMarkdown.en.openSplitEditMode",
    "onCommand:superMarkdown.zhCN.openSplitEditMode",
    "onCommand:superMarkdown.en.switchDisplayLanguage",
    "onCommand:superMarkdown.zhCN.switchDisplayLanguage",
    "onCommand:superMarkdown.en.switchBackgroundTheme",
    "onCommand:superMarkdown.zhCN.switchBackgroundTheme",
    "onCommand:superMarkdown.en.refreshPreview",
    "onCommand:superMarkdown.zhCN.refreshPreview",
    "onCommand:superMarkdown.en.organizeMarkdown",
    "onCommand:superMarkdown.zhCN.organizeMarkdown"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/extension.js",
    "media/preview.css",
    "media/export/markdown.css",
    "media/icons/**",
    "media/vendor/katex/katex.min.css",
    "media/vendor/katex/fonts/**",
    "media/vendor/mermaid/mermaid.min.js",
    "media/vendor/codicons/codicon.css",
    "media/vendor/codicons/codicon.ttf",
    "media/wysiwyg/editor.css",
    "media/wysiwyg/editor.js",
    "images/**",
    "docs/super-markdown/**",
    "README.md",
    "LICENSE",
    "package.json",
    "package.nls.json",
    "package.nls.zh-cn.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "superMarkdown.openEditor",
        "title": "%superMarkdown.command.openEditor%",
        "icon": "$(edit)"
      },
      {
        "command": "superMarkdown.openNativeTextEditor",
        "title": "%superMarkdown.command.openNativeTextEditor%",
        "icon": "$(file-code)"
      },
      {
        "command": "superMarkdown.openWysiwygEditor",
        "title": "%superMarkdown.command.openWysiwygEditor%",
        "icon": "$(notebook-edit)"
      },
      {
        "command": "superMarkdown.openPreview",
        "title": "%superMarkdown.command.previewMode%",
        "icon": "$(markdown)"
      },
      {
        "command": "superMarkdown.openSplitEditMode",
        "title": "%superMarkdown.command.splitEditMode%",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "superMarkdown.switchDisplayLanguage",
        "title": "%superMarkdown.command.switchDisplayLanguage%",
        "icon": "$(globe)"
      },
      {
        "command": "superMarkdown.switchBackgroundTheme",
        "title": "%superMarkdown.command.switchBackgroundTheme%",
        "icon": "$(color-mode)"
      },
      {
        "command": "superMarkdown.refreshPreview",
        "title": "%superMarkdown.command.refreshPreview%",
        "icon": "$(refresh)"
      },
      {
        "command": "superMarkdown.organizeMarkdown",
        "title": "%superMarkdown.command.organizeMarkdown%",
        "icon": "$(wand)"
      },
      {
        "command": "superMarkdown.export.settings",
        "title": "%superMarkdown.command.export.settings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "superMarkdown.export.html",
        "title": "%superMarkdown.command.export.html%",
        "icon": "$(file-code)"
      },
      {
        "command": "superMarkdown.export.pdf",
        "title": "%superMarkdown.command.export.pdf%",
        "icon": "$(file-pdf)"
      },
      {
        "command": "superMarkdown.export.png",
        "title": "%superMarkdown.command.export.png%",
        "icon": "$(file-media)"
      },
      {
        "command": "superMarkdown.export.jpeg",
        "title": "%superMarkdown.command.export.jpeg%",
        "icon": "$(file-media)"
      },
      {
        "command": "superMarkdown.export.all",
        "title": "%superMarkdown.command.export.all%",
        "icon": "$(files)"
      },
      {
        "command": "superMarkdown.export.choose",
        "title": "%superMarkdown.command.export.choose%",
        "icon": "$(export)"
      },
      {
        "command": "superMarkdown.openSyntaxGuide",
        "title": "%superMarkdown.command.openSyntaxGuide%",
        "icon": "$(book)"
      },
      {
        "command": "superMarkdown.copyTableAsJson",
        "title": "%superMarkdown.command.copyTableAsJson%",
        "icon": "$(json)"
      },
      {
        "command": "superMarkdown.copyJsonAsTable",
        "title": "%superMarkdown.command.copyJsonAsTable%",
        "icon": "$(table)"
      },
      {
        "command": "superMarkdown.en.openEditor",
        "title": "Super Markdown: Open Editor",
        "icon": "$(edit)"
      },
      {
        "command": "superMarkdown.zhCN.openEditor",
        "title": "Super Markdown：打开编辑器",
        "icon": "$(edit)"
      },
      {
        "command": "superMarkdown.en.openNativeTextEditor",
        "title": "Super Markdown: Open Native Editor",
        "icon": "$(file-code)"
      },
      {
        "command": "superMarkdown.zhCN.openNativeTextEditor",
        "title": "Super Markdown：打开原生编辑器",
        "icon": "$(file-code)"
      },
      {
        "command": "superMarkdown.en.openWysiwygEditor",
        "title": "Super Markdown: WYSIWYG Mode",
        "icon": "$(notebook-edit)"
      },
      {
        "command": "superMarkdown.zhCN.openWysiwygEditor",
        "title": "Super Markdown：所见即所得模式",
        "icon": "$(notebook-edit)"
      },
      {
        "command": "superMarkdown.en.openPreview",
        "title": "Super Markdown: Preview Mode",
        "icon": "$(markdown)"
      },
      {
        "command": "superMarkdown.zhCN.openPreview",
        "title": "Super Markdown：预览模式",
        "icon": "$(markdown)"
      },
      {
        "command": "superMarkdown.en.openSplitEditMode",
        "title": "Super Markdown: Split Edit Mode",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "superMarkdown.zhCN.openSplitEditMode",
        "title": "Super Markdown：分屏编辑模式",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "superMarkdown.en.switchDisplayLanguage",
        "title": "Super Markdown: Switch Display Language",
        "icon": "$(globe)"
      },
      {
        "command": "superMarkdown.zhCN.switchDisplayLanguage",
        "title": "Super Markdown：切换界面语言",
        "icon": "$(globe)"
      },
      {
        "command": "superMarkdown.en.switchBackgroundTheme",
        "title": "Super Markdown: Switch Reading Theme",
        "icon": "$(color-mode)"
      },
      {
        "command": "superMarkdown.zhCN.switchBackgroundTheme",
        "title": "Super Markdown：切换阅读主题",
        "icon": "$(color-mode)"
      },
      {
        "command": "superMarkdown.en.refreshPreview",
        "title": "Super Markdown: Refresh Preview",
        "icon": "$(refresh)"
      },
      {
        "command": "superMarkdown.zhCN.refreshPreview",
        "title": "Super Markdown：刷新预览",
        "icon": "$(refresh)"
      },
      {
        "command": "superMarkdown.en.organizeMarkdown",
        "title": "Super Markdown: Organize Markdown",
        "icon": "$(wand)"
      },
      {
        "command": "superMarkdown.zhCN.organizeMarkdown",
        "title": "Super Markdown：整理 Markdown",
        "icon": "$(wand)"
      }
    ],
    "customEditors": [
      {
        "viewType": "superMarkdown.editor",
        "displayName": "Super Markdown Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          },
          {
            "filenamePattern": "*.mdown"
          },
          {
            "filenamePattern": "*.mkdn"
          }
        ],
        "priority": "default"
      }
    ],
    "keybindings": [
      {
        "command": "superMarkdown.openSplitEditMode",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorLangId == markdown"
      },
      {
        "command": "superMarkdown.openEditor",
        "key": "ctrl+shift+alt+m",
        "mac": "cmd+shift+alt+m",
        "when": "editorLangId == markdown"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "superMarkdown.en.openNativeTextEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@10"
        },
        {
          "command": "superMarkdown.zhCN.openNativeTextEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@10"
        },
        {
          "command": "superMarkdown.en.openPreview",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@20"
        },
        {
          "command": "superMarkdown.zhCN.openPreview",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@20"
        },
        {
          "command": "superMarkdown.en.openSplitEditMode",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@21"
        },
        {
          "command": "superMarkdown.zhCN.openSplitEditMode",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@21"
        },
        {
          "command": "superMarkdown.en.openWysiwygEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@22"
        },
        {
          "command": "superMarkdown.zhCN.openWysiwygEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@22"
        },
        {
          "command": "superMarkdown.export.choose",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn",
          "group": "navigation@23"
        }
      ],
      "explorer/context": [
        {
          "command": "superMarkdown.en.openEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@10"
        },
        {
          "command": "superMarkdown.zhCN.openEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@10"
        },
        {
          "command": "superMarkdown.en.openNativeTextEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@11"
        },
        {
          "command": "superMarkdown.zhCN.openNativeTextEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@11"
        },
        {
          "command": "superMarkdown.en.openSplitEditMode",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@20"
        },
        {
          "command": "superMarkdown.zhCN.openSplitEditMode",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "superMarkdown.en.openPreview",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@20"
        },
        {
          "command": "superMarkdown.zhCN.openPreview",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@20"
        },
        {
          "command": "superMarkdown.en.openSplitEditMode",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@21"
        },
        {
          "command": "superMarkdown.zhCN.openSplitEditMode",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@21"
        },
        {
          "command": "superMarkdown.en.openWysiwygEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && !superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@22"
        },
        {
          "command": "superMarkdown.zhCN.openWysiwygEditor",
          "when": "(resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn) && superMarkdown.runtimeLanguageZhCN",
          "group": "navigation@22"
        },
        {
          "command": "superMarkdown.export.choose",
          "when": "resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .mdown || resourceExtname == .mkdn",
          "group": "navigation@23"
        }
      ],
      "commandPalette": [
        {
          "command": "superMarkdown.openEditor",
          "when": "false"
        },
        {
          "command": "superMarkdown.openNativeTextEditor",
          "when": "false"
        },
        {
          "command": "superMarkdown.openWysiwygEditor",
          "when": "false"
        },
        {
          "command": "superMarkdown.openPreview",
          "when": "false"
        },
        {
          "command": "superMarkdown.openSplitEditMode",
          "when": "false"
        },
        {
          "command": "superMarkdown.switchDisplayLanguage",
          "when": "false"
        },
        {
          "command": "superMarkdown.switchBackgroundTheme",
          "when": "false"
        },
        {
          "command": "superMarkdown.refreshPreview",
          "when": "false"
        },
        {
          "command": "superMarkdown.organizeMarkdown",
          "when": "false"
        },
        {
          "command": "superMarkdown.en.openEditor",
          "when": "!superMarkdown.runtimeLanguageZhCN"
        },
        {
          "command": "superMarkdown.zhCN.openEditor",
          "when": "superMarkdown.runtimeLanguageZhCN"
        },
        {
